{
  "model": "LCDWiki MPI2411 2.4inch RPi Display",
  "driver_ic": "ILI9341",
  "touch_ic": "XPT2046",
  "wiki": "http://www.lcdwiki.com/2.4inch_RPi_Display_For_RPi_3A+",
  "size_inch": 2.4,
  "native_px": [240, 320],
  "rot": 1,
  "rot_comment": "0/2 portrait 240x320, 1/3 landscape 320x240",
  "spi": {
    "lcd_dev": [0, 0],
    "touch_dev": [0, 1],
    "lcd_hz": 16000000,
    "touch_hz": 500000
  },
  "pins_bcm": {
    "lcd_dc": 22,
    "lcd_rst": 27,
    "touch_irq": 17,
    "comment": "DC=pin15 LCD_RS, RST=pin13, IRQ=pin11 TP_IRQ, CS LCD=CE0 pin24, CS touch=CE1 pin26"
  },
  "touch": {
    "raw_min": 200,
    "raw_max": 3900,
    "z_min": 80,
    "irq_active": "low",
    "any_tap_triggers_test": true
  },
  "boot": {
    "need": ["dtparam=spi=on"],
    "do_not_install": "goodtft LCD-show / LCD24-3A+-show (fights camera KMS)"
  },
  "run": "python3 rpi_monitoring/hello_lcd.py"
}
